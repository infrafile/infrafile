{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource",
  "description": "服务器以外的云资源：数据库、CDN、对象存储等。",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Resource"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["provider", "type"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "allOf": [{
        "if": {"required": ["origin"]},
        "then": {"anyOf": [
          {"properties": {"type": {"const": "cdn"}}},
          {"properties": {"type": {"const": "dns-zone"}, "provider": {"const": "cloudflare"}}}
        ]}
      }],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "type": {"description": "资源类型，如 mysql、redis、cdn、bucket。", "type": "string", "minLength": 1},
        "account": {"type": "string", "x-ref": "Account"},
        "server": {"description": "自建在某台服务器上时填写。", "type": "string", "x-ref": "Server"},
        "resource_id": {"type": "string"},
        "region": {"type": "string"},
        "endpoint": {"type": "string"},
        "expires_at": {"$ref": "common.schema.json#/$defs/date"},
        "origin": {
          "description": "期望回源集合；不从观测自动导入。端口、协议只在显式声明时比较。",
          "type": "object",
          "required": ["hosts"],
          "additionalProperties": false,
          "properties": {
            "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "protocol": {"enum": ["http", "https", "follow"]}
          }
        },
        "control": {
          "type": "object",
          "required": [
            "plugin",
            "instance",
            "zone_id"
          ],
          "additionalProperties": false,
          "properties": {
            "plugin": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "instance": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "zone_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 128
            },
            "ruleset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 128
            },
            "rule_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 128
            }
          }
        },
        "secrets": {"$ref": "common.schema.json#/$defs/secrets"}
      }
    }
  }
}
