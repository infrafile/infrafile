{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain",
  "description": "一个注册的域名。metadata.name 就是域名本身。",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Domain"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "registrar": {"type": "string"},
        "account": {"description": "注册商账号。", "type": "string", "x-ref": "Account"},
        "dns_account": {"description": "托管 DNS 的账号，与注册商不同时填写。", "type": "string", "x-ref": "Account"},
        "expires_at": {"$ref": "common.schema.json#/$defs/date"},
        "bindings": {
          "description": "子域名指向哪里。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {"description": "子域名，根域名写 @。", "type": "string", "minLength": 1},
              "server": {"type": "string", "x-ref": "Server"},
              "app": {"type": "string", "x-ref": "App"},
              "resource": {"type": "string", "x-ref": "Resource"}
            }
          }
        },
        "dns": {
          "type": "object",
          "required": [
            "provider",
            "records"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 64
            },
            "records": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "content"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^(?:@|(?:\\*\\.)?(?:[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]*[A-Za-z0-9_])?)*|\\*)$"
                  },
                  "type": {
                    "enum": [
                      "A",
                      "AAAA",
                      "CNAME",
                      "MX",
                      "TXT",
                      "NS",
                      "CAA"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ttl": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "tag": {
                    "enum": [
                      "issue",
                      "issuewild",
                      "iodef"
                    ]
                  },
                  "proxied": {
                    "type": "boolean"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "A"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "content": {
                          "format": "ipv4"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "AAAA"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "content": {
                          "format": "ipv6"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "CNAME",
                            "MX",
                            "NS"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "content": {
                          "format": "hostname"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "MX"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "priority"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "priority"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "CAA"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "tag"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "tag"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "A",
                            "AAAA",
                            "CNAME"
                          ]
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "proxied"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "NS"
                        },
                        "name": {
                          "const": "@"
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "ttl"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "secrets": {"$ref": "common.schema.json#/$defs/secrets"}
      }
    }
  }
}
