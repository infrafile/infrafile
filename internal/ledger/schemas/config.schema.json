{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "数据仓配置文件 infrafile.yaml。",
  "type": "object",
  "required": ["apiVersion", "kind"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Config"},
    "storageVersion": {
      "description": "显式启用 v1 管理记录存储契约。旧版不识别此字段并拒绝业务操作；缺省保持既有数据布局，不自动升级。",
      "const": "v1"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "type": "object",
        "required": ["instances"],
        "additionalProperties": false,
        "properties": {
          "instances": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/name"},
            "additionalProperties": {"type": "object"}
          }
        }
      }
    },
    "audit": {
      "description": "审计设置。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watch": {
          "description": "missing 的显式检查范围；每个在用目标只绑定一个插件实例和服务。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "plugin", "instance", "service"],
            "additionalProperties": false,
            "properties": {
              "target": {"type": "string", "pattern": "^(Domain|Resource)/[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"},
              "plugin": {"enum": ["aliyun", "tencent", "baidu", "ctyun", "cloudflare"]},
              "instance": {"$ref": "#/$defs/name"},
              "service": {"enum": ["domains", "cdn", "zones"]}
            }
          }
        },
        "ignore": {
          "description": "stale_state 按实例豁免；orphan/zombie 必须用 match 精确指定单个观测身份。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "plugin", "instance", "reason"],
            "additionalProperties": false,
            "if": {"properties": {"rule": {"const": "stale_state"}}},
            "then": {"not": {"required": ["match"]}},
            "else": {"required": ["match"]},
            "properties": {
              "rule": {"description": "要豁免的审计规则。", "enum": ["stale_state", "orphan", "zombie"]},
              "plugin": {"$ref": "#/$defs/name"},
              "instance": {"$ref": "#/$defs/name"},
              "match": {"$ref": "#/$defs/identity"},
              "reason": {"description": "为什么豁免。", "type": "string", "minLength": 1},
              "until": {"description": "可选的失效日期；过期后审计重新报告。", "$ref": "common.schema.json#/$defs/date"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "description": "观测条目的精确自然身份；不支持通配符或部分匹配。",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Domain"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "address"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Server"
            },
            "address": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "provider",
            "resource_id"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Resource"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "resource_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "provider",
            "type",
            "endpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "Resource"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "name": {"type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"}
  }
}
