{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo",
  "description": "一个代码仓库。",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Repo"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "required": ["remote"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "remote": {"type": "string", "minLength": 1},
        "platform": {"description": "托管平台，如 github、gitea。", "type": "string"},
        "app": {"description": "这个仓库是哪个应用的代码。", "type": "string", "x-ref": "App"},
        "deploys_to": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["server"],
            "additionalProperties": false,
            "properties": {
              "server": {"type": "string", "x-ref": "Server"},
              "path": {"type": "string"}
            }
          }
        },
        "secrets": {"$ref": "common.schema.json#/$defs/secrets"}
      }
    }
  }
}
